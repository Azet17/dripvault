# NEAR mainnet account that would own the scheduler (NEAR Intents has no testnet — FAQ Q-007).
# Use a DEDICATED dev account with tiny amounts, never your main wallet.
NEAR_ACCOUNT=your-dev.near
# Private key of that account, used to sign each drip. Never commit the real .env.
NEAR_PRIVATE_KEY=ed25519:...
# Optional 1Click JWT (lower partner fee); without it a 0.2% fee applies.
ONECLICK_JWT=
