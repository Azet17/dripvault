# DripVault wet-run signing (scheduler.py --wet refuses to start without these).
# Use a DEDICATED dev account with tiny amounts — never your main wallet.
# NEAR Intents has no testnet (hackathon FAQ Q-007), so this is mainnet.
NEAR_MAIN_ACCOUNT=your-dev.near
NEAR_MAIN_KEY=ed25519:...
# Optional 1Click JWT (lower partner fee); without it a 0.2% fee applies.
ONECLICK_JWT=
